generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Docente {
  id           Int       @id @default(autoincrement())
  nombres      String
  apellidos    String
  dni          String    @unique
  correo       String?   @unique
  estadoActivo Boolean   @default(true)
  horarios     Horario[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("docentes")
}

model Curso {
  id       Int       @id @default(autoincrement())
  nombre   String
  horarios Horario[]

  @@map("cursos")
}

model Aula {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  horarios Horario[]

  @@map("aulas")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Horario {
  id         Int          @id @default(autoincrement())
  docenteId  Int
  docente    Docente      @relation(fields: [docenteId], references: [id])
  cursoId    Int
  curso      Curso        @relation(fields: [cursoId], references: [id])
  aulaId     Int
  aula       Aula         @relation(fields: [aulaId], references: [id])
  diaSemana  DiaSemana
  horaInicio DateTime     @db.Time
  horaFin    DateTime     @db.Time
  activo     Boolean      @default(true)
  sesiones   SesionClase[]
  createdAt  DateTime     @default(now())

  @@index([docenteId, diaSemana])
  @@index([aulaId, diaSemana])
  @@map("horarios")
}

enum EstadoSesion {
  PROGRAMADA
  INICIADA
  FINALIZADA
  TARDANZA
  AUSENTE
}

model SesionClase {
  id                   Int          @id @default(autoincrement())
  horarioId            Int
  horario              Horario      @relation(fields: [horarioId], references: [id])
  fecha                DateTime     @db.Date
  horaInicioProgramada DateTime     @db.Time
  horaFinProgramada    DateTime     @db.Time
  estado               EstadoSesion @default(PROGRAMADA)
  horaEntradaReal      DateTime?
  horaSalidaReal       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([horarioId, fecha])
  @@index([fecha, estado])
  @@map("sesiones_clase")
}
